{
 "slug": "pdf-cover-cards",
 "module": "pdf-cover-cards/src/cover",
 "function": "coverTarget",
 "note": "args = [property value as text]; expected = {path, page} of the PDF to draw, or null when the value is not a PDF link. Page defaults to 1.",
 "cases": [
  {
   "name": "literal percent sequence in a wiki path",
   "args": [
    "[[資料/100%20real.pdf]]"
   ],
   "expected": {
    "path": "資料/100%20real.pdf",
    "page": 1
   }
  },
  {
   "name": "Unicode angle destination with parentheses",
   "args": [
    "[paper](<資料/Mon%20été%20(1).pdf#page=2>)"
   ],
   "expected": {
    "path": "資料/Mon été (1).pdf",
    "page": 2
   }
  },
  {
   "name": "wikilink",
   "args": [
    "[[Papers/Attention.pdf]]"
   ],
   "expected": {
    "path": "Papers/Attention.pdf",
    "page": 1
   }
  },
  {
   "name": "wikilink with page and alias",
   "args": [
    "[[Attention.pdf#page=3|paper]]"
   ],
   "expected": {
    "path": "Attention.pdf",
    "page": 3
   }
  },
  {
   "name": "embed form",
   "args": [
    "![[scan.PDF]]"
   ],
   "expected": {
    "path": "scan.PDF",
    "page": 1
   }
  },
  {
   "name": "markdown link with encoded space",
   "args": [
    "[x](My%20Book.pdf#page=12)"
   ],
   "expected": {
    "path": "My Book.pdf",
    "page": 12
   }
  },
  {
   "name": "markdown link in angle brackets",
   "args": [
    "[Manual](<Docs/User manual.pdf>)"
   ],
   "expected": {
    "path": "Docs/User manual.pdf",
    "page": 1
   }
  },
  {
   "name": "bare path",
   "args": [
    "Books/manual.pdf"
   ],
   "expected": {
    "path": "Books/manual.pdf",
    "page": 1
   }
  },
  {
   "name": "bare path with page",
   "args": [
    "Books/manual.pdf#page=7"
   ],
   "expected": {
    "path": "Books/manual.pdf",
    "page": 7
   }
  },
  {
   "name": "surrounding spaces",
   "args": [
    "  [[a b.pdf]]  "
   ],
   "expected": {
    "path": "a b.pdf",
    "page": 1
   }
  },
  {
   "name": "page with other pdf.js parameters",
   "args": [
    "[[a.pdf#zoom=50&page=4]]"
   ],
   "expected": {
    "path": "a.pdf",
    "page": 4
   }
  },
  {
   "name": "heading subpath is page 1",
   "args": [
    "[[a.pdf#Chapter 2]]"
   ],
   "expected": {
    "path": "a.pdf",
    "page": 1
   }
  },
  {
   "name": "bad percent encoding kept as written",
   "args": [
    "[x](50%25%zz.pdf)"
   ],
   "expected": {
    "path": "50%25%zz.pdf",
    "page": 1
   }
  },
  {
   "name": "not a pdf",
   "args": [
    "[[cover.png]]"
   ],
   "expected": null
  },
  {
   "name": "pdf in the middle of a name",
   "args": [
    "[[report.pdf.md]]"
   ],
   "expected": null
  },
  {
   "name": "external url",
   "args": [
    "https://example.com/paper"
   ],
   "expected": null
  },
  {
   "name": "empty value",
   "args": [
    ""
   ],
   "expected": null
  },
  {
   "name": "page zero falls back to 1",
   "args": [
    "[[a.pdf#page=0]]"
   ],
   "expected": {
    "path": "a.pdf",
    "page": 1
   }
  },
  {
   "name": "page past the end keeps the number (the renderer clamps it to the page count)",
   "args": [
    "[[a.pdf#page=99]]"
   ],
   "expected": {
    "path": "a.pdf",
    "page": 99
   }
  },
  {
   "name": "page that is not a number falls back to 1",
   "args": [
    "[[a.pdf#page=abc]]"
   ],
   "expected": {
    "path": "a.pdf",
    "page": 1
   }
  }
 ],
 "imageFunction": "chooseImage",
 "imageNote": "args = [CoverInput, vault paths]; a link path resolves to the exact vault path or to the one vault path that ends in /<link path>. expected = vault path of the image cover, or null.",
 "imageCases": [
  {
   "name": "wiki image in the property",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[Scans/Moss.jpg]]"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "Scans/Moss.jpg"
  },
  {
   "name": "markdown image with encoded space",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[x](My%20Scan.png)"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "My Scan.png"
  },
  {
   "name": "wiki path keeps a literal percent sequence",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[100%25 scan.png]]"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "100%25 scan.png"
  },
  {
   "name": "image entry is its own cover",
   "args": [
    {
     "self": {
      "path": "Cover.webp",
      "ext": "webp"
     },
     "property": [],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "Cover.webp"
  },
  {
   "name": "external image URL",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "https://example.com/a.png"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": null
  },
  {
   "name": "link to a note",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[notes.md]]"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": null
  },
  {
   "name": "body embed when links are on",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [],
     "links": [
      "Moss.jpg#crop"
     ],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "Scans/Moss.jpg"
  },
  {
   "name": "body embed when links are off",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [],
     "links": [
      "Scans/Moss.jpg"
     ],
     "useLinks": false
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": null
  },
  {
   "name": "property before body, upper-case extension",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[Missing.png]]",
      "![[Kiln.PNG|200]]"
     ],
     "links": [
      "Scans/Moss.jpg"
     ],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "Scans/Kiln.PNG"
  },
  {
   "name": "a PDF link is not an image",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[Attention.pdf]]"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": null
  }
 ],
 "wheelNote": "wheelCases: fn names the function. wheelPixels(args[0]) gives page pixels (positive = next page). wheelTurn(carry, pixels) gives {step, carry}. turnTarget(page, step, pages) gives the page.",
 "wheelCases": [
  {
   "name": "plain vertical scroll does not turn pages",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": 0,
     "deltaY": 120,
     "deltaMode": 0,
     "shiftKey": false,
     "ctrlKey": false,
     "metaKey": false,
     "altKey": false
    }
   ],
   "expected": 0
  },
  {
   "name": "vertical scroll with a small horizontal drift does not turn pages",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": 8,
     "deltaY": 40,
     "deltaMode": 0,
     "shiftKey": false,
     "ctrlKey": false,
     "metaKey": false,
     "altKey": false
    }
   ],
   "expected": 0
  },
  {
   "name": "horizontal swipe to the right is the next page",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": 30,
     "deltaY": 4,
     "deltaMode": 0,
     "shiftKey": false,
     "ctrlKey": false,
     "metaKey": false,
     "altKey": false
    }
   ],
   "expected": 30
  },
  {
   "name": "horizontal swipe to the left is the previous page",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": -25,
     "deltaY": 0,
     "deltaMode": 0,
     "shiftKey": false,
     "ctrlKey": false,
     "metaKey": false,
     "altKey": false
    }
   ],
   "expected": -25
  },
  {
   "name": "Shift with the wheel down is the next page",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": 0,
     "deltaY": 100,
     "deltaMode": 0,
     "shiftKey": true,
     "ctrlKey": false,
     "metaKey": false,
     "altKey": false
    }
   ],
   "expected": 100
  },
  {
   "name": "Shift with the wheel that the OS made horizontal",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": -100,
     "deltaY": 0,
     "deltaMode": 0,
     "shiftKey": true,
     "ctrlKey": false,
     "metaKey": false,
     "altKey": false
    }
   ],
   "expected": -100
  },
  {
   "name": "Ctrl with the wheel is zoom, not a page turn",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": 50,
     "deltaY": 100,
     "deltaMode": 0,
     "shiftKey": false,
     "ctrlKey": true,
     "metaKey": false,
     "altKey": false
    }
   ],
   "expected": 0
  },
  {
   "name": "Cmd with the wheel is not a page turn",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": 50,
     "deltaY": 0,
     "deltaMode": 0,
     "shiftKey": false,
     "ctrlKey": false,
     "metaKey": true,
     "altKey": false
    }
   ],
   "expected": 0
  },
  {
   "name": "Alt with the wheel is not a page turn",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": 0,
     "deltaY": 100,
     "deltaMode": 0,
     "shiftKey": true,
     "ctrlKey": false,
     "metaKey": false,
     "altKey": true
    }
   ],
   "expected": 0
  },
  {
   "name": "line mode counts 40 pixels a line",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": 0,
     "deltaY": 3,
     "deltaMode": 1,
     "shiftKey": true,
     "ctrlKey": false,
     "metaKey": false,
     "altKey": false
    }
   ],
   "expected": 120
  },
  {
   "name": "page mode counts 800 pixels a page",
   "fn": "wheelPixels",
   "args": [
    {
     "deltaX": 1,
     "deltaY": 0,
     "deltaMode": 2,
     "shiftKey": false,
     "ctrlKey": false,
     "metaKey": false,
     "altKey": false
    }
   ],
   "expected": 800
  },
  {
   "name": "sum below the step keeps the sum",
   "fn": "wheelTurn",
   "args": [
    20,
    30
   ],
   "expected": {
    "step": 0,
    "carry": 50
   }
  },
  {
   "name": "sum reaches the step: one page, sum resets",
   "fn": "wheelTurn",
   "args": [
    50,
    15
   ],
   "expected": {
    "step": 1,
    "carry": 0
   }
  },
  {
   "name": "one large event turns one page only",
   "fn": "wheelTurn",
   "args": [
    0,
    800
   ],
   "expected": {
    "step": 1,
    "carry": 0
   }
  },
  {
   "name": "backward sum gives the previous page",
   "fn": "wheelTurn",
   "args": [
    -40,
    -40
   ],
   "expected": {
    "step": -1,
    "carry": 0
   }
  },
  {
   "name": "direction change starts the sum again",
   "fn": "wheelTurn",
   "args": [
    55,
    -10
   ],
   "expected": {
    "step": 0,
    "carry": -10
   }
  },
  {
   "name": "zero pixels keep the sum",
   "fn": "wheelTurn",
   "args": [
    30,
    0
   ],
   "expected": {
    "step": 0,
    "carry": 30
   }
  },
  {
   "name": "next page from 2 of 4",
   "fn": "turnTarget",
   "args": [
    2,
    1,
    4
   ],
   "expected": 3
  },
  {
   "name": "stops at the last page",
   "fn": "turnTarget",
   "args": [
    4,
    1,
    4
   ],
   "expected": 4
  },
  {
   "name": "stops at page 1",
   "fn": "turnTarget",
   "args": [
    1,
    -1,
    4
   ],
   "expected": 1
  },
  {
   "name": "a page past the end is the last page",
   "fn": "turnTarget",
   "args": [
    99,
    0,
    4
   ],
   "expected": 4
  },
  {
   "name": "page 0 is page 1",
   "fn": "turnTarget",
   "args": [
    0,
    0,
    4
   ],
   "expected": 1
  },
  {
   "name": "one-page PDF stays on page 1",
   "fn": "turnTarget",
   "args": [
    1,
    1,
    1
   ],
   "expected": 1
  },
  {
   "name": "no page count stays on page 1",
   "fn": "turnTarget",
   "args": [
    3,
    1,
    0
   ],
   "expected": 1
  }
 ]
}
