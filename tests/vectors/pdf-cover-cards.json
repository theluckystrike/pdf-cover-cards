{
 "slug": "pdf-cover-cards",
 "module": "pdf-cover-cards/src/cover",
 "function": "coverTarget",
 "note": "args = [property value as text]; expected = {path, page} of the PDF to draw, or null when the value is not a PDF link. Page defaults to 1.",
 "cases": [
  {
   "name": "literal percent sequence in a wiki path",
   "args": [
    "[[資料/100%20real.pdf]]"
   ],
   "expected": {
    "path": "資料/100%20real.pdf",
    "page": 1
   }
  },
  {
   "name": "Unicode angle destination with parentheses",
   "args": [
    "[paper](<資料/Mon%20été%20(1).pdf#page=2>)"
   ],
   "expected": {
    "path": "資料/Mon été (1).pdf",
    "page": 2
   }
  },
  {
   "name": "wikilink",
   "args": [
    "[[Papers/Attention.pdf]]"
   ],
   "expected": {
    "path": "Papers/Attention.pdf",
    "page": 1
   }
  },
  {
   "name": "wikilink with page and alias",
   "args": [
    "[[Attention.pdf#page=3|paper]]"
   ],
   "expected": {
    "path": "Attention.pdf",
    "page": 3
   }
  },
  {
   "name": "embed form",
   "args": [
    "![[scan.PDF]]"
   ],
   "expected": {
    "path": "scan.PDF",
    "page": 1
   }
  },
  {
   "name": "markdown link with encoded space",
   "args": [
    "[x](My%20Book.pdf#page=12)"
   ],
   "expected": {
    "path": "My Book.pdf",
    "page": 12
   }
  },
  {
   "name": "markdown link in angle brackets",
   "args": [
    "[Manual](<Docs/User manual.pdf>)"
   ],
   "expected": {
    "path": "Docs/User manual.pdf",
    "page": 1
   }
  },
  {
   "name": "bare path",
   "args": [
    "Books/manual.pdf"
   ],
   "expected": {
    "path": "Books/manual.pdf",
    "page": 1
   }
  },
  {
   "name": "bare path with page",
   "args": [
    "Books/manual.pdf#page=7"
   ],
   "expected": {
    "path": "Books/manual.pdf",
    "page": 7
   }
  },
  {
   "name": "surrounding spaces",
   "args": [
    "  [[a b.pdf]]  "
   ],
   "expected": {
    "path": "a b.pdf",
    "page": 1
   }
  },
  {
   "name": "page with other pdf.js parameters",
   "args": [
    "[[a.pdf#zoom=50&page=4]]"
   ],
   "expected": {
    "path": "a.pdf",
    "page": 4
   }
  },
  {
   "name": "heading subpath is page 1",
   "args": [
    "[[a.pdf#Chapter 2]]"
   ],
   "expected": {
    "path": "a.pdf",
    "page": 1
   }
  },
  {
   "name": "bad percent encoding kept as written",
   "args": [
    "[x](50%25%zz.pdf)"
   ],
   "expected": {
    "path": "50%25%zz.pdf",
    "page": 1
   }
  },
  {
   "name": "not a pdf",
   "args": [
    "[[cover.png]]"
   ],
   "expected": null
  },
  {
   "name": "pdf in the middle of a name",
   "args": [
    "[[report.pdf.md]]"
   ],
   "expected": null
  },
  {
   "name": "external url",
   "args": [
    "https://example.com/paper"
   ],
   "expected": null
  },
  {
   "name": "empty value",
   "args": [
    ""
   ],
   "expected": null
  },
  {
   "name": "page zero falls back to 1",
   "args": [
    "[[a.pdf#page=0]]"
   ],
   "expected": {
    "path": "a.pdf",
    "page": 1
   }
  }
 ],
 "imageFunction": "chooseImage",
 "imageNote": "args = [CoverInput, vault paths]; a link path resolves to the exact vault path or to the one vault path that ends in /<link path>. expected = vault path of the image cover, or null.",
 "imageCases": [
  {
   "name": "wiki image in the property",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[Scans/Moss.jpg]]"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "Scans/Moss.jpg"
  },
  {
   "name": "markdown image with encoded space",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[x](My%20Scan.png)"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "My Scan.png"
  },
  {
   "name": "wiki path keeps a literal percent sequence",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[100%25 scan.png]]"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "100%25 scan.png"
  },
  {
   "name": "image entry is its own cover",
   "args": [
    {
     "self": {
      "path": "Cover.webp",
      "ext": "webp"
     },
     "property": [],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "Cover.webp"
  },
  {
   "name": "external image URL",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "https://example.com/a.png"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": null
  },
  {
   "name": "link to a note",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[notes.md]]"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": null
  },
  {
   "name": "body embed when links are on",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [],
     "links": [
      "Moss.jpg#crop"
     ],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "Scans/Moss.jpg"
  },
  {
   "name": "body embed when links are off",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [],
     "links": [
      "Scans/Moss.jpg"
     ],
     "useLinks": false
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": null
  },
  {
   "name": "property before body, upper-case extension",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[Missing.png]]",
      "![[Kiln.PNG|200]]"
     ],
     "links": [
      "Scans/Moss.jpg"
     ],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": "Scans/Kiln.PNG"
  },
  {
   "name": "a PDF link is not an image",
   "args": [
    {
     "self": {
      "path": "Library/Note.md",
      "ext": "md"
     },
     "property": [
      "[[Attention.pdf]]"
     ],
     "links": [],
     "useLinks": true
    },
    [
     "Scans/Moss.jpg",
     "My Scan.png",
     "100%25 scan.png",
     "Cover.webp",
     "notes.md",
     "Papers/Attention.pdf",
     "Scans/Kiln.PNG"
    ]
   ],
   "expected": null
  }
 ]
}
